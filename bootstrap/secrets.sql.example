-- PopoSafari — R2 자격증명 템플릿
--
-- 실물은 /srv/warehouse/secrets.sql (0600). **레포에 커밋 금지** (.gitignore 에 있다).
--
-- ⚠️ R2 API 토큰은 poposafari-analytics 버킷 **'읽기 전용'** 으로 새로 발급할 것.
--    backup-pg.sh 가 쓰는 쓰기 토큰을 재사용하면, 미니 PC 한 대가 침해됐을 때
--    prod 백업 버킷(poposafari-backups) 전체의 삭제 권한까지 함께 넘어간다.
--    그 버킷의 pg_dump 에는 session.id — 살아있는 인증 토큰 — 가 들어 있다.
--    "R2 자격증명이 이미 뚫려 있다"를 근거로 재사용하면 이 함정에 빠진다.
--
-- PERSISTENT SECRET 이라 한 번 등록하면 ~/.duckdb/stored_secrets/ 에 남는다.
-- 즉 매 실행마다 이 파일을 읽을 필요는 없다 — load/run.sh 가 그래도 읽는 건
-- 자격증명이 바뀌었을 때 자동으로 반영되게 하려는 것이다.

CREATE OR REPLACE PERSISTENT SECRET r2 (
  TYPE r2,
  ACCOUNT_ID '<CLOUDFLARE_ACCOUNT_ID>',
  KEY_ID     '<R2_ACCESS_KEY_ID>',
  SECRET     '<R2_SECRET_ACCESS_KEY>'
);
