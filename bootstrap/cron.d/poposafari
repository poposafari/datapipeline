# PopoSafari 데이터 파이프라인 — 미니 PC
#
# install.sh 가 @REPO@ / @LOG@ / @USER@ 를 치환해 /etc/cron.d/poposafari 로 설치한다.
#
# ★ CRON_TZ 를 명시한다. 안 쓰면 호스트 로컬 시간(KST)으로 해석되어,
#   아래 주석의 UTC 계산이 9시간 어긋난다.
CRON_TZ=UTC
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# ── 적재 — 19:00 UTC = 04:00 KST ─────────────────────────────────────
# 순서가 중요하다. prod 재스윕이 03:10 UTC 에 backfill/dt=<어제>/resweep.csv.gz 를
# 쓴다. 적재를 그보다 앞서 돌리면 그날 갭 보충분을 하루 늦게 받는다.
# 19:00 UTC 면 충분히 뒤다.
0 19 * * *   @USER@  @REPO@/load/run.sh        >> @LOG@/load.log  2>&1

# ── 대사 — 19:30 UTC = 04:30 KST ─────────────────────────────────────
# 적재가 끝난 뒤여야 한다. prod 에 접근하지 않고 R2 의 meta/counts.csv.gz 만 읽는다.
30 19 * * *  @USER@  @REPO@/checks/reconcile.sh >> @LOG@/check.log 2>&1
